diff --git a/src/reader_util.cpp b/src/reader_util.cpp
index 8c084b0..6f44e97 100644
--- a/src/reader_util.cpp
+++ b/src/reader_util.cpp
@@ -45,6 +45,145 @@ namespace lcf {
 namespace ReaderUtil {
 }
 
+#if LCF_SUPPORT_ICONV
+/*
+ * Without ICU's charset detector: a guess from the bytes alone, best first, in the names ICU's detector gives
+ * (the ones EasyRPG Player knows). The Player tries each in turn against the game's files and keeps the first
+ * one whose file names it finds, so a plausible second choice still helps.
+ */
+static std::vector<std::string> GuessEncodings(std::string_view text) {
+	const auto* b = reinterpret_cast<const unsigned char*>(text.data());
+	const size_t n = text.size();
+
+	size_t high = 0;
+	for (size_t i = 0; i < n; ++i) {
+		high += b[i] >= 0x80;
+	}
+	if (high == 0) {
+		return {"ibm-5348_P100-1997"};
+	}
+
+	// UTF-8: only valid sequences
+	bool utf8 = true;
+	for (size_t i = 0; i < n && utf8;) {
+		const unsigned char c = b[i];
+		const size_t len = c < 0x80 ? 1 : (c & 0xE0) == 0xC0 ? 2 : (c & 0xF0) == 0xE0 ? 3 : (c & 0xF8) == 0xF0 ? 4 : 0;
+		if (len == 0 || (len == 2 && c < 0xC2) || i + len > n) {
+			utf8 = false;
+			break;
+		}
+		for (size_t k = 1; k < len; ++k) {
+			if ((b[i + k] & 0xC0) != 0x80) {
+				utf8 = false;
+			}
+		}
+		i += len;
+	}
+
+	// Shift-JIS (CP932): lead 81-9F / E0-FC, trail 40-7E / 80-FC; A1-DF are half-width katakana. Japanese text is
+	// mostly hiragana, katakana and punctuation, whose leads are 81-83: Cyrillic letters (C0-FF) also pair up, but
+	// never with a lead below A0
+	size_t sjis_pairs = 0, sjis_low_leads = 0, sjis_kana = 0, sjis_bad = 0;
+	for (size_t i = 0; i < n; ++i) {
+		const unsigned char c = b[i];
+		if (c < 0x80) {
+			continue;
+		}
+		if (c >= 0xA1 && c <= 0xDF) {
+			++sjis_kana;
+		} else if (((c >= 0x81 && c <= 0x9F) || (c >= 0xE0 && c <= 0xFC)) && i + 1 < n &&
+				((b[i + 1] >= 0x40 && b[i + 1] <= 0x7E) || (b[i + 1] >= 0x80 && b[i + 1] <= 0xFC))) {
+			++sjis_pairs;
+			sjis_low_leads += c <= 0x9F;
+			++i;
+		} else {
+			++sjis_bad;
+		}
+	}
+
+	// The EUC-style double-byte encodings (CP949, CP936, CP950): lead and trail both A1-FE in their common range
+	size_t euc_pairs = 0, euc_bad = 0, hangul_leads = 0, big5_pairs = 0, big5_bad = 0;
+	for (size_t i = 0; i < n; ++i) {
+		const unsigned char c = b[i];
+		if (c < 0x80) {
+			continue;
+		}
+		if (c >= 0x81 && c <= 0xFE && i + 1 < n && b[i + 1] >= 0x41 && b[i + 1] <= 0xFE) {
+			++euc_pairs;
+			hangul_leads += c >= 0xB0 && c <= 0xC8 && b[i + 1] >= 0xA1;
+			++i;
+		} else {
+			++euc_bad;
+		}
+	}
+	for (size_t i = 0; i < n; ++i) {
+		const unsigned char c = b[i];
+		if (c < 0x80) {
+			continue;
+		}
+		if (c >= 0xA1 && c <= 0xF9 && i + 1 < n &&
+				((b[i + 1] >= 0x40 && b[i + 1] <= 0x7E) || (b[i + 1] >= 0xA1 && b[i + 1] <= 0xFE))) {
+			++big5_pairs;
+			++i;
+		} else {
+			++big5_bad;
+		}
+	}
+
+	// The single-byte ones: Cyrillic letters are C0-FF in windows-1251, Western text has few high bytes and
+	// mostly accented letters
+	size_t letters_c0 = 0;
+	for (size_t i = 0; i < n; ++i) {
+		letters_c0 += b[i] >= 0xC0;
+	}
+
+	std::vector<std::string> result;
+	auto add = [&](const char* enc) {
+		if (std::find(result.begin(), result.end(), enc) == result.end()) {
+			result.emplace_back(enc);
+		}
+	};
+
+	if (utf8) {
+		add("UTF-8");
+	}
+	// Japanese: every high byte in a valid pair, and few half-width katakana (Cyrillic and Western text read as
+	// Shift-JIS turns into mostly katakana)
+	const bool sjis = sjis_bad == 0 && sjis_pairs > 0 && sjis_kana * 4 <= sjis_pairs && sjis_low_leads * 2 >= sjis_pairs;
+	const bool euc = euc_bad == 0 && euc_pairs > 0;
+	const bool korean = euc && hangul_leads * 10 >= euc_pairs * 7;
+	const bool cyrillic = letters_c0 * 10 >= high * 7 && high * 2 >= n && high >= 3;
+	if (sjis) {
+		add("ibm-943_P15A-2003");
+	}
+	if (korean) {
+		add("windows-949-2000");
+	}
+	if (cyrillic) {
+		add("ibm-5347_P100-1998");
+	}
+	if (euc && !korean) {
+		add("windows-936-2000");
+	}
+	if (big5_bad == 0 && big5_pairs > 0 && !korean) {
+		add("Big5");
+	}
+	// what is left, the likely ones first
+	add("ibm-5348_P100-1997");
+	if (sjis_bad == 0 && sjis_pairs > 0) {
+		add("ibm-943_P15A-2003");
+	}
+	if (euc) {
+		add(korean ? "windows-936-2000" : "windows-949-2000");
+	}
+	if (!cyrillic) {
+		add("ibm-5347_P100-1998");
+	}
+	add("ibm-5346_P100-1998");
+	return result;
+}
+#endif
