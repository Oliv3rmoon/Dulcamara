+#if LCF_SUPPORT_ICONV
+/* The names liblcf and EasyRPG Player use for the encodings (ICU's), as iconv knows them. */
+static std::string iconvName(const std::string& enc) {
+	static const struct { const char* icu; const char* iconv; } names[] = {
+		{"ibm-943_P15A-2003", "CP932"},  // Japanese, \ as backslash
+		{"windows-949-2000", "CP949"},   // Korean
+		{"windows-936-2000", "CP936"},   // Simplified Chinese
+		{"Big5", "CP950"},               // Traditional Chinese
+		{"ibm-5348_P100-1997", "CP1252"}, // Western with Euro
+		{"ibm-5346_P100-1998", "CP1250"}, // Central European
+		{"ibm-5347_P100-1998", "CP1251"}, // Cyrillic
+		{"ibm-5349_P100-1998", "CP1253"}, // Greek
+		{"ibm-9447_P100-2002", "CP1255"}, // Hebrew
+		{"ibm-9448_X100-2005", "CP1256"}, // Arabic
+	};
+	for (const auto& n: names) {
+		if (enc == n.icu) {
+			return n.iconv;
+		}
+	}
+	if (enc.rfind("windows-", 0) == 0) {
+		// windows-1252, windows-949-2000...: CP and the number
+		auto number = enc.substr(8);
+		auto dash = number.find('-');
+		return "CP" + number.substr(0, dash);
+	}
+	return enc;
+}
+
+/* Some iconv builds lack a CP name that another spelling of the same encoding has. */
+static iconv_t iconvOpen(const std::string& to, const std::string& from) {
+	iconv_t cd = iconv_open(to.c_str(), from.c_str());
+	if (cd != (iconv_t)-1) {
+		return cd;
+	}
+	static const struct { const char* cp; const char* other; } others[] = {
+		{"CP932", "SHIFT_JIS"}, {"CP949", "UHC"}, {"CP936", "GBK"}, {"CP950", "BIG5"},
+	};
+	for (const auto& o: others) {
+		if (to == o.cp) {
+			return iconv_open(o.other, from.c_str());
+		}
+		if (from == o.cp) {
+			return iconv_open(to.c_str(), o.other);
+		}
+	}
+	return (iconv_t)-1;
+}
