+
+void Encoder::Convert(std::string& str, void* conv_dst, void*) {
+	auto cd = static_cast<iconv_t>(conv_dst);
+	iconv(cd, nullptr, nullptr, nullptr, nullptr); // back to the initial state
+
+	_buffer.resize(str.size() * 4 + 16);
+	std::string src = str;
+	char* in = &src[0];
+	size_t in_left = src.size();
+	char* out = _buffer.data();
+	size_t out_left = _buffer.size();
+
+	auto grow = [&]() {
+		const size_t used = out - _buffer.data();
+		_buffer.resize(_buffer.size() * 2);
+		out = _buffer.data() + used;
+		out_left = _buffer.size() - used;
+	};
+
+	// A byte the encoding has no character for: in a one-byte Windows code page converted to UTF-8, the Latin-1
+	// character of that byte (what liblcf's own windows-1252 conversion gives, and ICU's tables map most of them
+	// to); otherwise '?', as ICU substitutes. The first few are logged.
+	static int reports = 0;
+	const bool latin1 = _single_byte && conv_dst == _conv_runtime;
+	while (in_left > 0) {
+		if (iconv(cd, &in, &in_left, &out, &out_left) != (size_t)-1) {
+			break;
+		}
+		if (errno == E2BIG) {
+			grow();
+			continue;
+		}
+		if (!latin1 && reports < 5) {
+			Log::Warning("iconv() could not convert a character of \"%s\": %s", str.c_str(), strerror(errno));
+			++reports;
+		}
+		if (out_left < 2) {
+			grow();
+		}
+		const unsigned char byte = static_cast<unsigned char>(*in);
+		if (latin1 && byte >= 0x80) {
+			*out++ = static_cast<char>(0xC0 | (byte >> 6));
+			*out++ = static_cast<char>(0x80 | (byte & 0x3F));
+			out_left -= 2;
+		} else {
+			*out++ = '?';
+			--out_left;
+		}
+		++in;
+		--in_left;
+	}
+	while (iconv(cd, nullptr, nullptr, &out, &out_left) == (size_t)-1 && errno == E2BIG) {
+		grow();
+	}
+
+	str.assign(_buffer.data(), out - _buffer.data());
+}
