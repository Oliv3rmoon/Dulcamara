+// Optional Dulcamara contract: no native game writer starts before release.
+static dr_save_layout dc_saves;
+static bool dc_pending_start, dc_stop, dc_finished;
+static void dc_copy(dr_save_layout* out) { *out = dc_saves; }
+static bool dc_release(uint32_t generation) {
+    if (!dc_saves.checkpoint || generation != dc_saves.generation || dc_stop) return false;
+    dc_saves.checkpoint = false;
+    dc_pending_start = false;
+    init_easy_rpg();
+    Player::Run();
+    return true;
+}
+static void dc_request_stop() { dc_stop = true; }
+static dr_stop_result dc_poll_stop() {
+    if (dc_finished) return DR_STOP_CLEAN;
+    if (!dc_stop) return DR_STOP_RUNNING;
+    if (!dc_pending_start && !LibretroUi::player_exit_called) Player::Exit();
+    LibretroUi::player_exit_called = true;
+    dc_pending_start = false; dc_finished = true;
+    dc_saves.checkpoint = false; dc_saves.writers_finished = true;
+    return DR_STOP_CLEAN;
+}
+
