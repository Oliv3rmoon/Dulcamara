Dulcamara: the FFT's dispatch tables out of the code, into .rodata.

The PS5 maps an executable's code execute-only: a read of it, as FFT_DISPATCH's of its table of entry points (kept
in .text, as offsets from the start of the section), ends the app, with no crash report. The FFT is the first step
of each Vorbis packet's IMDCT, so a game ended on its first OGG sound (Dulcamara 0.2.6 to 0.2.8). The tables now count
from a label at the start of .text and live in .rodata; each entry names the same function as before.

--- a/libavcodec/x86/fft.asm
+++ b/libavcodec/x86/fft.asm
@@ -92,6 +92,9 @@
 
 SECTION .text
 
+; where the dispatch tables' offsets count from: the tables are kept in .rodata, out of the code
+fft_text:
+
 %macro T2_3DNOW 4 ; z0, z1, mem0, mem1
     mova     %1, %3
     mova     %2, %1
@@ -549,7 +552,7 @@
     lea r2, [dispatch_tab%1]
     mov r2, [r2 + (%2q-2)*gprsize]
 %ifdef PIC
-    lea r3, [$$]
+    lea r3, [fft_text]
     add r2, r3
 %endif
     call r2
@@ -732,7 +735,7 @@
 %endif
 
 %ifdef PIC
-%define SECTION_REL - $$
+%define SECTION_REL - fft_text
 %else
 %define SECTION_REL
 %endif
@@ -773,8 +776,10 @@
 %endrep
 %undef n
 
+SECTION_RODATA 32
 align 8
 dispatch_tab %+ fullsuffix: pointer list_of_fft
+SECTION .text
 %endmacro ; DECL_FFT
 
 %if HAVE_AVX_EXTERNAL
